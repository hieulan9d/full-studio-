 "sections": [
  {
   "id": "c01",
   "title": "c01",
   "start": 0.0,
   "end": 5.67,
   "script": "",
   "onscreen": [
    {
     "start": 0.0,
     "end": 1.08,
     "text": "Nhiều bệnh nặng không có triệu",
     "style": "Sub"
    },
    {
     "start": 1.1,
     "end": 2.44,
     "text": "chứng cho đến khi quá muộn.",
     "style": "Sub"
    },
    {
     "start": 2.46,
     "end": 3.54,
     "text": "Có năm việc kiểm tra sớm,",
     "style": "Sub"
    },
    {
     "start": 3.56,
     "end": 4.6,
     "text": "giúp bạn phát hiện từ đầu.",
     "style": "Sub"
    },
    {
     "start": 4.62,
     "end": 5.48,
     "text": "Một – Đo huyết áp.",
     "style": "Sub"
    },
    {
     "start": 5.5,
     "end": 6.56,
     "text": "Máy đo chỉ mất một phút,",
     "style": "Sub"
    },
    {
     "start": 6.58,
     "end": 7.26,
     "text": "nhưng mấy ai đo?",
     "style": "Sub"
    },
    {
     "start": 7.28,
     "end": 9.16,
     "text": "Ở Việt Nam, 28,3% người",
     "style": "Sub"
    },
    {
     "start": 9.18,
     "end": 11.38,
     "text": "từ 25 đến 64 tuổi bị tăng huyết áp.",
     "style": "Sub"
    },
    {
     "start": 11.4,
     "end": 12.98,
     "text": "Ở Trung Quốc, 44,7% người",
     "style": "Sub"
    },
    {
     "start": 13.0,
     "end": 15.18,
     "text": "từ 35 đến 75 tuổi bị tăng huyết áp,",
     "style": "Sub"
    },
    {
     "start": 15.44,
     "end": 17.54,
     "text": "nhưng chỉ 7,2% kiểm soát được.",
     "style": "Sub"
    },
    {
     "start": 17.56,
     "end": 20.14,
     "text": "Mỗi lần huyết áp tâm thu giảm 10 mmHg,",
     "style": "Sub"
    },
    {
     "start": 20.16,
     "end": 23.62,
     "text": "đột quỵ giảm 27%, suy tim giảm 28%,",
     "style": "Sub"
    },
    {
     "start": 23.64,
     "end": 26.05,
     "text": "và nguy cơ mất mạng giảm 13%.",
     "style": "Sub"
    },
    {
     "start": 26.07,
     "end": 27.22,
     "text": "Hai – Kiểm tra đường huyết.",
     "style": "Sub"
    },
    {
     "start": 27.62,
     "end": 28.68,
     "text": "Từ 35 tuổi,",
     "style": "Sub"
    },
    {
     "start": 28.7,
     "end": 30.14,
     "text": "nếu thừa cân thì xét nghiệm một lần.",
     "style": "Sub"
    },
    {
     "start": 30.16,
     "end": 31.94,
     "text": "Bình thường thì 3 năm sau kiểm tra lại.",
     "style": "Sub"
    },
    {
     "start": 32.0,
     "end": 33.56,
     "text": "Ngưỡng cân nặng trong sách là của Mỹ",
     "style": "Sub"
    },
    {
     "start": 33.58,
     "end": 35.14,
     "text": "và Trung Quốc, hãy hỏi bác sĩ",
     "style": "Sub"
    },
    {
     "start": 35.16,
     "end": 36.24,
     "text": "ngưỡng phù hợp với người Việt.",
     "style": "Sub"
    },
    {
     "start": 36.26,
     "end": 37.74,
     "text": "Ba – Sàng lọc ung thư.",
     "style": "Sub"
    },
    {
     "start": 37.76,
     "end": 39.8,
     "text": "Phụ nữ từ 40 đến 74 tuổi,",
     "style": "Sub"
    },
    {
     "start": 39.82,
     "end": 41.26,
     "text": "2 năm chụp nhũ ảnh một lần",
     "style": "Sub"
    },
    {
     "start": 41.28,
     "end": 42.18,
     "text": "theo khuyến nghị của Mỹ.",
     "style": "Sub"
    },
    {
     "start": 42.3,
     "end": 43.74,
     "text": "Siêu âm và cộng hưởng từ làm thêm",
     "style": "Sub"
    },
    {
     "start": 43.76,
     "end": 45.14,
     "text": "cho mô vú đặc chưa đủ bằng chứng.",
     "style": "Sub"
    },
    {
     "start": 45.52,
     "end": 47.52,
     "text": "Từ 30 tuổi, ưu tiên xét nghiệm HPV,",
     "style": "Sub"
    },
    {
     "start": 47.54,
     "end": 48.8,
     "text": "âm tính thì 5 năm làm lại.",
     "style": "Sub"
    },
    {
     "start": 49.4,
     "end": 51.68,
     "text": "Từ 45 đến 50 tuổi, xét nghiệm máu ẩn",
     "style": "Sub"
    },
    {
     "start": 51.7,
     "end": 52.74,
     "text": "trong phân hoặc nội soi.",
     "style": "Sub"
    },
    {
     "start": 52.76,
     "end": 54.6,
     "text": "Nội soi âm tính thì 10 năm làm lại.",
     "style": "Sub"
    },
    {
     "start": 54.62,
     "end": 55.26,
     "text": "Ở Việt Nam,",
     "style": "Sub"
    },
    {
     "start": 55.28,
     "end": 56.64,
     "text": "ung thư vú có nhiều ca mới nhất,",
     "style": "Sub"
    },
    {
     "start": 56.66,
     "end": 58.18,
     "text": "hơn 25.000 ca mỗi năm.",
     "style": "Sub"
    },
    {
     "start": 58.2,
     "end": 59.3,
     "text": "Ung thư phổi khiến nhiều",
     "style": "Sub"
    },
    {
     "start": 59.32,
     "end": 59.96,
     "text": "người mất mạng nhất.",
     "style": "Sub"
    },
    {
     "start": 59.98,
     "end": 62.14,
     "text": "Bốn – Tiệt trừ vi khuẩn HP trong dạ dày.",
     "style": "Sub"
    },
    {
     "start": 62.48,
     "end": 64.24,
     "text": "Theo dõi 22 năm ở Sơn Đông,",
     "style": "Sub"
    },
    {
     "start": 64.28,
     "end": 65.84,
     "text": "tiệt trừ HP giảm khoảng một nửa",
     "style": "Sub"
    },
    {
     "start": 65.86,
     "end": 66.94,
     "text": "nguy cơ ung thư dạ dày.",
     "style": "Sub"
    },
    {
     "start": 66.96,
     "end": 68.52,
     "text": "Ở Việt Nam, một nghiên cứu cho thấy",
     "style": "Sub"
    },
    {
     "start": 68.54,
     "end": 69.74,
     "text": "ở nhóm điều trị thất bại ít",
     "style": "Sub"
    },
    {
     "start": 69.76,
     "end": 72.02,
     "text": "nhất hai lần, 96,5% chủng HP",
     "style": "Sub"
    },
    {
     "start": 72.04,
     "end": 73.54,
     "text": "kháng thuốc clarithromycin.",
     "style": "Sub"
    },
    {
     "start": 73.56,
     "end": 74.88,
     "text": "Vì vậy hãy uống đủ liều,",
     "style": "Sub"
    },
    {
     "start": 74.9,
     "end": 76.46,
     "text": "đủ ngày theo chỉ định của bác sĩ.",
     "style": "Sub"
    },
    {
     "start": 76.48,
     "end": 77.7,
     "text": "Năm – Phát hiện rung nhĩ.",
     "style": "Sub"
    },
    {
     "start": 77.72,
     "end": 80.24,
     "text": "Thuốc chống đông giảm khoảng 60% nguy cơ",
     "style": "Sub"
    },
    {
     "start": 80.26,
     "end": 81.84,
     "text": "đột quỵ ở người được đánh giá phù hợp.",
     "style": "Sub"
    },
    {
     "start": 81.86,
     "end": 83.06,
     "text": "Aspirin không thay thế được.",
     "style": "Sub"
    },
    {
     "start": 83.1,
     "end": 85.16,
     "text": "Ở Trung Quốc, chỉ 6% người rung nhĩ",
     "style": "Sub"
    },
    {
     "start": 85.18,
     "end": 86.74,
     "text": "nguy cơ cao đang dùng thuốc chống đông.",
     "style": "Sub"
    },
    {
     "start": 86.76,
     "end": 88.44,
     "text": "Không tự ngừng thuốc vì hết hồi hộp.",
     "style": "Sub"
    },
    {
     "start": 88.46,
     "end": 89.9,
     "text": "Méo miệng, yếu một bên tay chân,",
     "style": "Sub"
    },
    {
     "start": 89.92,
     "end": 92.0,
     "text": "hoặc nói khó, hãy gọi số 115 ngay.",
     "style": "Sub"
    },
    {
     "start": 92.02,
     "end": 93.12,
     "text": "Năm việc kiểm tra sớm,",
     "style": "Sub"
    },
    {
     "start": 93.14,
     "end": 94.1,
     "text": "mất rất ít thời gian.",
     "style": "Sub"
    },
    {
     "start": 94.12,
     "end": 94.68,
     "text": "Hôm nay,",
     "style": "Sub"
    },
    {
     "start": 94.7,
     "end": 96.36,
     "text": "hãy bắt đầu bằng việc đo huyết áp.",
     "style": "Sub"
    }
   ]
  },
