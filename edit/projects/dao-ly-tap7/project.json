 "sections": [
  {
   "id": "c01",
   "title": "c01",
   "start": 0.0,
   "end": 4.88,
   "script": "",
   "onscreen": [
    {
     "start": 0.0,
     "end": 1.16,
     "text": "Có những dấu hiệu nhỏ của cơ thể,",
     "style": "Sub"
    },
    {
     "start": 1.18,
     "end": 2.3,
     "text": "và những chuyện khó nói,",
     "style": "Sub"
    },
    {
     "start": 2.32,
     "end": 3.5,
     "text": "mà bạn không nên bỏ qua.",
     "style": "Sub"
    },
    {
     "start": 3.6,
     "end": 4.62,
     "text": "Một – Tiểu ra máu.",
     "style": "Sub"
    },
    {
     "start": 4.64,
     "end": 5.48,
     "text": "Một lần, không đau,",
     "style": "Sub"
    },
    {
     "start": 5.5,
     "end": 6.96,
     "text": "hôm sau hết, vẫn phải đi khám.",
     "style": "Sub"
    },
    {
     "start": 6.98,
     "end": 9.06,
     "text": "Số liệu ở Anh cho thấy khoảng 2,8%",
     "style": "Sub"
    },
    {
     "start": 9.08,
     "end": 11.02,
     "text": "người trên 60 tuổi có tiểu máu cuối",
     "style": "Sub"
    },
    {
     "start": 11.04,
     "end": 12.54,
     "text": "cùng được chẩn đoán ung thư bàng quang.",
     "style": "Sub"
    },
    {
     "start": 12.82,
     "end": 15.38,
     "text": "Ở người từ 40 đến 59 tuổi là 1,2%.",
     "style": "Sub"
    },
    {
     "start": 15.4,
     "end": 16.38,
     "text": "Tỷ lệ không cao,",
     "style": "Sub"
    },
    {
     "start": 16.4,
     "end": 17.76,
     "text": "nhưng đủ để phải kiểm tra một lần.",
     "style": "Sub"
    },
    {
     "start": 17.78,
     "end": 18.82,
     "text": "Hai – Rối loạn cương dương",
     "style": "Sub"
    },
    {
     "start": 18.84,
     "end": 19.98,
     "text": "không chỉ là chuyện ấy.",
     "style": "Sub"
    },
    {
     "start": 20.0,
     "end": 21.64,
     "text": "Người bị rối loạn cương dương có nguy cơ",
     "style": "Sub"
    },
    {
     "start": 21.66,
     "end": 23.92,
     "text": "bệnh tim mạch cao hơn khoảng 40%,",
     "style": "Sub"
    },
    {
     "start": 23.94,
     "end": 26.28,
     "text": "và nhồi máu cơ tim cao hơn khoảng 60%.",
     "style": "Sub"
    },
    {
     "start": 26.3,
     "end": 27.44,
     "text": "Hãy đo huyết áp,",
     "style": "Sub"
    },
    {
     "start": 27.46,
     "end": 28.48,
     "text": "đường huyết, mỡ máu trước.",
     "style": "Sub"
    },
    {
     "start": 28.5,
     "end": 30.24,
     "text": "Đừng tự mua thuốc để che đi vấn đề.",
     "style": "Sub"
    },
    {
     "start": 30.26,
     "end": 31.74,
     "text": "Ngày 2 tháng 4 năm 2025,",
     "style": "Sub"
    },
    {
     "start": 32.24,
     "end": 33.96,
     "text": "Cục An toàn thực phẩm công bố cả",
     "style": "Sub"
    },
    {
     "start": 33.98,
     "end": 35.52,
     "text": "bảy mẫu thực phẩm bảo vệ sức khỏe",
     "style": "Sub"
    },
    {
     "start": 35.54,
     "end": 37.0,
     "text": "quảng cáo tăng cường sinh lý nam",
     "style": "Sub"
    },
    {
     "start": 37.02,
     "end": 38.52,
     "text": "đều chứa hoạt chất của thuốc kê đơn.",
     "style": "Sub"
    },
    {
     "start": 38.78,
     "end": 40.06,
     "text": "Giảm cân, bỏ thuốc lá,",
     "style": "Sub"
    },
    {
     "start": 40.12,
     "end": 41.52,
     "text": "kiểm soát huyết áp và đường huyết",
     "style": "Sub"
    },
    {
     "start": 41.54,
     "end": 42.78,
     "text": "cũng giúp chức năng này tốt lên.",
     "style": "Sub"
    },
    {
     "start": 42.8,
     "end": 44.16,
     "text": "Ba – Dùng bao cao su,",
     "style": "Sub"
    },
    {
     "start": 44.18,
     "end": 45.74,
     "text": "và không dùng chung bơm kim tiêm.",
     "style": "Sub"
    },
    {
     "start": 45.76,
     "end": 47.4,
     "text": "Dùng lần nào cũng đủ suốt quá trình,",
     "style": "Sub"
    },
    {
     "start": 47.52,
     "end": 49.14,
     "text": "giảm hơn 70% nguy cơ",
     "style": "Sub"
    },
    {
     "start": 49.16,
     "end": 50.2,
     "text": "lây HIV giữa nam và nữ.",
     "style": "Sub"
    },
    {
     "start": 50.22,
     "end": 51.52,
     "text": "Chỉ dùng phần lớn các lần",
     "style": "Sub"
    },
    {
     "start": 51.54,
     "end": 53.14,
     "text": "thì gần như không khác gì không dùng.",
     "style": "Sub"
    },
    {
     "start": 53.16,
     "end": 54.66,
     "text": "Bao cao su cũng không chặn hoàn",
     "style": "Sub"
    },
    {
     "start": 54.68,
     "end": 56.2,
     "text": "toàn giang mai và mụn rộp sinh dục",
     "style": "Sub"
    },
    {
     "start": 56.22,
     "end": 57.1,
     "text": "ở vùng không được che.",
     "style": "Sub"
    },
    {
     "start": 57.12,
     "end": 58.36,
     "text": "Bốn – Xét nghiệm HIV",
     "style": "Sub"
    },
    {
     "start": 58.38,
     "end": 59.78,
     "text": "nếu từng có hành vi nguy cơ.",
     "style": "Sub"
    },
    {
     "start": 59.8,
     "end": 61.26,
     "text": "Người dùng thuốc đều đặn đến",
     "style": "Sub"
    },
    {
     "start": 61.28,
     "end": 62.56,
     "text": "khi virus không phát hiện được",
     "style": "Sub"
    },
    {
     "start": 62.58,
     "end": 63.88,
     "text": "thì không lây cho bạn tình.",
     "style": "Sub"
    },
    {
     "start": 63.9,
     "end": 65.96,
     "text": "Giữa năm 2025, nước ta có hơn",
     "style": "Sub"
    },
    {
     "start": 65.98,
     "end": 68.38,
     "text": "267.000 người nhiễm HIV còn sống.",
     "style": "Sub"
    },
    {
     "start": 68.4,
     "end": 69.54,
     "text": "Luật cấm công khai tên,",
     "style": "Sub"
    },
    {
     "start": 69.56,
     "end": 70.86,
     "text": "địa chỉ, hình ảnh người nhiễm.",
     "style": "Sub"
    },
    {
     "start": 71.2,
     "end": 72.4,
     "text": "Từ đủ 15 tuổi,",
     "style": "Sub"
    },
    {
     "start": 72.42,
     "end": 73.86,
     "text": "bạn được tự nguyện yêu cầu xét nghiệm.",
     "style": "Sub"
    },
    {
     "start": 73.88,
     "end": 76.02,
     "text": "Năm – Thuốc dự phòng trước phơi nhiễm,",
     "style": "Sub"
    },
    {
     "start": 76.04,
     "end": 76.78,
     "text": "chỉ dùng theo đơn,",
     "style": "Sub"
    },
    {
     "start": 76.8,
     "end": 77.86,
     "text": "không tự mua tự uống.",
     "style": "Sub"
    },
    {
     "start": 78.5,
     "end": 80.32,
     "text": "Dùng đều, nguy cơ nhiễm HIV thấp",
     "style": "Sub"
    },
    {
     "start": 80.34,
     "end": 81.98,
     "text": "hơn khoảng 70% so với giả dược.",
     "style": "Sub"
    },
    {
     "start": 82.0,
     "end": 83.3,
     "text": "Quy trình gồm xét nghiệm HIV,",
     "style": "Sub"
    },
    {
     "start": 83.4,
     "end": 84.52,
     "text": "đánh giá thận và viêm gan,",
     "style": "Sub"
    },
    {
     "start": 84.54,
     "end": 85.68,
     "text": "tái khám sau 1 tháng.",
     "style": "Sub"
    },
    {
     "start": 85.7,
     "end": 87.72,
     "text": "Nếu đã có phơi nhiễm, cần đánh giá",
     "style": "Sub"
    },
    {
     "start": 87.74,
     "end": 89.1,
     "text": "điều trị dự phòng sau phơi nhiễm,",
     "style": "Sub"
    },
    {
     "start": 89.12,
     "end": 90.74,
     "text": "không tự chuyển sang dùng thuốc",
     "style": "Sub"
    },
    {
     "start": 90.76,
     "end": 91.74,
     "text": "dự phòng trước phơi nhiễm.",
     "style": "Sub"
    },
    {
     "start": 91.76,
     "end": 92.56,
     "text": "Năm điều nhỏ,",
     "style": "Sub"
    },
    {
     "start": 92.58,
     "end": 93.96,
     "text": "có thể cứu bạn khỏi những chuyện lớn.",
     "style": "Sub"
    },
    {
     "start": 93.98,
     "end": 95.78,
     "text": "Có dấu hiệu lạ, hãy đi khám, đừng ngại.",
     "style": "Sub"
    }
   ]
  },
