 "sections": [
  {
   "id": "c01",
   "title": "c01",
   "start": 0.0,
   "end": 6.42,
   "script": "",
   "onscreen": [
    {
     "start": 0.0,
     "end": 1.86,
     "text": "Ba việc nhỏ trong nhà, tốn rất ít tiền,",
     "style": "Sub"
    },
    {
     "start": 1.88,
     "end": 3.26,
     "text": "mà giúp trẻ nhỏ và người già",
     "style": "Sub"
    },
    {
     "start": 3.28,
     "end": 4.44,
     "text": "tránh được tai nạn đáng tiếc.",
     "style": "Sub"
    },
    {
     "start": 4.46,
     "end": 5.64,
     "text": "Một – Chốt giới hạn cho cửa sổ",
     "style": "Sub"
    },
    {
     "start": 5.66,
     "end": 6.2,
     "text": "và ban công.",
     "style": "Sub"
    },
    {
     "start": 6.24,
     "end": 7.34,
     "text": "Lưới chống muỗi không phải",
     "style": "Sub"
    },
    {
     "start": 7.36,
     "end": 8.08,
     "text": "biện pháp bảo vệ.",
     "style": "Sub"
    },
    {
     "start": 8.1,
     "end": 9.44,
     "text": "Chốt giới hạn giá rất rẻ,",
     "style": "Sub"
    },
    {
     "start": 9.46,
     "end": 10.64,
     "text": "lắp chỉ mất khoảng 10 phút.",
     "style": "Sub"
    },
    {
     "start": 10.66,
     "end": 12.18,
     "text": "Ở New York, chính quyền phát chắn cửa",
     "style": "Sub"
    },
    {
     "start": 12.2,
     "end": 13.84,
     "text": "sổ miễn phí cho hộ có nguy cơ cao.",
     "style": "Sub"
    },
    {
     "start": 13.86,
     "end": 15.16,
     "text": "Sau 3 năm, số trẻ rơi ngã",
     "style": "Sub"
    },
    {
     "start": 15.18,
     "end": 16.06,
     "text": "ở một quận giảm một nửa.",
     "style": "Sub"
    },
    {
     "start": 16.08,
     "end": 17.04,
     "text": "Ở Hà Nội, trẻ rơi",
     "style": "Sub"
    },
    {
     "start": 17.06,
     "end": 18.56,
     "text": "từ chung cư đã xảy ra nhiều lần,",
     "style": "Sub"
    },
    {
     "start": 18.58,
     "end": 20.4,
     "text": "có vụ từ tầng 11, có vụ từ tầng 24.",
     "style": "Sub"
    },
    {
     "start": 20.42,
     "end": 21.88,
     "text": "Một kiến trúc sư khuyến nghị:",
     "style": "Sub"
    },
    {
     "start": 21.9,
     "end": 23.72,
     "text": "lan can cao tối thiểu 1,1 m,",
     "style": "Sub"
    },
    {
     "start": 23.74,
     "end": 25.36,
     "text": "khe hở dưới 10 cm,",
     "style": "Sub"
    },
    {
     "start": 25.38,
     "end": 27.04,
     "text": "cửa sổ chỉ mở hé khoảng 15 độ.",
     "style": "Sub"
    },
    {
     "start": 27.06,
     "end": 28.52,
     "text": "Hai – Cho trẻ mặc áo phao",
     "style": "Sub"
    },
    {
     "start": 28.54,
     "end": 29.18,
     "text": "khi ở gần nước.",
     "style": "Sub"
    },
    {
     "start": 29.2,
     "end": 31.0,
     "text": "Áo phao giảm khoảng một nửa nguy cơ",
     "style": "Sub"
    },
    {
     "start": 31.02,
     "end": 32.16,
     "text": "đuối nước khi rơi xuống nước.",
     "style": "Sub"
    },
    {
     "start": 32.2,
     "end": 32.9,
     "text": "Năm 2021,",
     "style": "Sub"
    },
    {
     "start": 33.18,
     "end": 34.82,
     "text": "nước ta có hơn 4.000 người đuối nước,",
     "style": "Sub"
    },
    {
     "start": 34.84,
     "end": 36.96,
     "text": "40% là trẻ dưới 14 tuổi.",
     "style": "Sub"
    },
    {
     "start": 36.98,
     "end": 38.0,
     "text": "Đuối nước là nguyên nhân",
     "style": "Sub"
    },
    {
     "start": 38.02,
     "end": 39.3,
     "text": "hàng đầu khiến trẻ mất mạng,",
     "style": "Sub"
    },
    {
     "start": 39.32,
     "end": 40.94,
     "text": "nhất là từ 5 đến 14 tuổi.",
     "style": "Sub"
    },
    {
     "start": 40.96,
     "end": 42.38,
     "text": "Không để trẻ một mình gần nước,",
     "style": "Sub"
    },
    {
     "start": 42.4,
     "end": 43.22,
     "text": "dù chỉ chốc lát.",
     "style": "Sub"
    },
    {
     "start": 43.24,
     "end": 43.92,
     "text": "Dạy trẻ bơi",
     "style": "Sub"
    },
    {
     "start": 43.94,
     "end": 45.22,
     "text": "và kỹ năng an toàn dưới nước.",
     "style": "Sub"
    },
    {
     "start": 45.24,
     "end": 46.6,
     "text": "Rào chắn khu vực nguy hiểm.",
     "style": "Sub"
    },
    {
     "start": 46.62,
     "end": 47.54,
     "text": "Và học sơ cứu.",
     "style": "Sub"
    },
    {
     "start": 47.56,
     "end": 49.04,
     "text": "Ba – Người trên 60 tuổi.",
     "style": "Sub"
    },
    {
     "start": 49.06,
     "end": 50.88,
     "text": "Tập thăng bằng 2 đến 3 lần mỗi tuần,",
     "style": "Sub"
    },
    {
     "start": 50.9,
     "end": 52.0,
     "text": "ví dụ thái cực quyền,",
     "style": "Sub"
    },
    {
     "start": 52.02,
     "end": 53.94,
     "text": "giảm khoảng 23% số lần ngã.",
     "style": "Sub"
    },
    {
     "start": 53.96,
     "end": 55.1,
     "text": "Hơn một nửa số vụ ngã",
     "style": "Sub"
    },
    {
     "start": 55.12,
     "end": 56.74,
     "text": "ở người cao tuổi xảy ra ngay trong nhà.",
     "style": "Sub"
    },
    {
     "start": 56.76,
     "end": 58.5,
     "text": "Cải tạo nhà giảm khoảng 20%.",
     "style": "Sub"
    },
    {
     "start": 58.52,
     "end": 60.04,
     "text": "Thảm chống trượt trong phòng tắm,",
     "style": "Sub"
    },
    {
     "start": 60.06,
     "end": 60.94,
     "text": "tay vịn cầu thang,",
     "style": "Sub"
    },
    {
     "start": 60.96,
     "end": 62.66,
     "text": "đèn ngủ ban đêm đều là việc dễ làm.",
     "style": "Sub"
    },
    {
     "start": 62.68,
     "end": 63.88,
     "text": "Ba việc nhỏ, làm một lần,",
     "style": "Sub"
    },
    {
     "start": 63.9,
     "end": 65.28,
     "text": "giữ an toàn cho cả nhà.",
     "style": "Sub"
    },
    {
     "start": 65.34,
     "end": 65.9,
     "text": "Hôm nay,",
     "style": "Sub"
    },
    {
     "start": 65.92,
     "end": 67.44,
     "text": "hãy kiểm tra chốt cửa sổ nhà bạn.",
     "style": "Sub"
    }
   ]
  },
