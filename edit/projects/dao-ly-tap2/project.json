 "sections": [
  {
   "id": "c01",
   "title": "c01",
   "start": 0.0,
   "end": 7.03,
   "script": "",
   "onscreen": [
    {
     "start": 0.0,
     "end": 1.01,
     "text": "Có năm việc trong nhà,",
     "style": "Sub"
    },
    {
     "start": 1.03,
     "end": 2.08,
     "text": "gần như không tốn tiền,",
     "style": "Sub"
    },
    {
     "start": 2.1,
     "end": 3.47,
     "text": "mà giảm rõ rệt nguy cơ gặp nạn",
     "style": "Sub"
    },
    {
     "start": 3.49,
     "end": 4.94,
     "text": "khi có cháy, gas hay khí độc.",
     "style": "Sub"
    },
    {
     "start": 5.0,
     "end": 6.96,
     "text": "Một – Lắp báo khói và báo khí CO.",
     "style": "Sub"
    },
    {
     "start": 7.03,
     "end": 9.4,
     "text": "Báo khói hoạt động giúp giảm khoảng 60%",
     "style": "Sub"
    },
    {
     "start": 9.42,
     "end": 10.86,
     "text": "nguy cơ mất mạng khi cháy nhà.",
     "style": "Sub"
    },
    {
     "start": 10.93,
     "end": 12.88,
     "text": "Ở Mỹ, 41% vụ cháy xảy ra",
     "style": "Sub"
    },
    {
     "start": 12.9,
     "end": 14.08,
     "text": "lúc mọi người đang ngủ.",
     "style": "Sub"
    },
    {
     "start": 14.14,
     "end": 15.86,
     "text": "Ngày 12 tháng 9 năm 2023,",
     "style": "Sub"
    },
    {
     "start": 15.88,
     "end": 16.95,
     "text": "vụ cháy chung cư mini",
     "style": "Sub"
    },
    {
     "start": 16.97,
     "end": 19.3,
     "text": "ở Khương Hạ làm 56 người mất mạng.",
     "style": "Sub"
    },
    {
     "start": 19.36,
     "end": 20.34,
     "text": "Nguyên nhân là chập điện",
     "style": "Sub"
    },
    {
     "start": 20.36,
     "end": 21.82,
     "text": "ở bình ắc quy xe máy để tầng một.",
     "style": "Sub"
    },
    {
     "start": 21.89,
     "end": 23.35,
     "text": "Không đốt than sưởi trong phòng kín,",
     "style": "Sub"
    },
    {
     "start": 23.37,
     "end": 24.08,
     "text": "kể cả khi tắm.",
     "style": "Sub"
    },
    {
     "start": 24.14,
     "end": 26.16,
     "text": "Khoảng 40% người bị ngạt khí CO",
     "style": "Sub"
    },
    {
     "start": 26.18,
     "end": 27.01,
     "text": "để lại di chứng.",
     "style": "Sub"
    },
    {
     "start": 27.07,
     "end": 28.8,
     "text": "Cháy thì gọi số 114. Cấp cứu",
     "style": "Sub"
    },
    {
     "start": 28.82,
     "end": 30.06,
     "text": "thì gọi số 115.",
     "style": "Sub"
    },
    {
     "start": 30.12,
     "end": 31.05,
     "text": "Hai – Ngửi thấy mùi gas,",
     "style": "Sub"
    },
    {
     "start": 31.07,
     "end": 32.5,
     "text": "đóng ngay van tổng hoặc van bình.",
     "style": "Sub"
    },
    {
     "start": 32.57,
     "end": 34.02,
     "text": "Ống và bếp gas hết hạn thì thay,",
     "style": "Sub"
    },
    {
     "start": 34.04,
     "end": 34.72,
     "text": "đừng tự sửa.",
     "style": "Sub"
    },
    {
     "start": 34.79,
     "end": 35.58,
     "text": "Mở cửa ra.",
     "style": "Sub"
    },
    {
     "start": 35.64,
     "end": 36.96,
     "text": "Không bật quạt, không bật đèn,",
     "style": "Sub"
    },
    {
     "start": 36.98,
     "end": 38.09,
     "text": "không dùng thiết bị điện,",
     "style": "Sub"
    },
    {
     "start": 38.11,
     "end": 39.07,
     "text": "không đụng bật lửa.",
     "style": "Sub"
    },
    {
     "start": 39.14,
     "end": 40.26,
     "text": "Ra ngoài rồi mới gọi.",
     "style": "Sub"
    },
    {
     "start": 40.33,
     "end": 41.34,
     "text": "Ba – Không đưa xe điện vào",
     "style": "Sub"
    },
    {
     "start": 41.36,
     "end": 42.33,
     "text": "hành lang hay thang máy,",
     "style": "Sub"
    },
    {
     "start": 42.35,
     "end": 43.28,
     "text": "không sạc trong nhà.",
     "style": "Sub"
    },
    {
     "start": 43.35,
     "end": 45.42,
     "text": "Trung Quốc năm 2021 có 18.000 vụ",
     "style": "Sub"
    },
    {
     "start": 45.44,
     "end": 47.82,
     "text": "cháy xe đạp điện, 65 người mất mạng,",
     "style": "Sub"
    },
    {
     "start": 47.84,
     "end": 49.57,
     "text": "gần như tất cả đều ở trong nhà.",
     "style": "Sub"
    },
    {
     "start": 49.63,
     "end": 51.06,
     "text": "Pin lithium cháy lan chỉ trong vài",
     "style": "Sub"
    },
    {
     "start": 51.08,
     "end": 52.62,
     "text": "chục giây và sinh ra khói rất độc.",
     "style": "Sub"
    },
    {
     "start": 52.68,
     "end": 53.49,
     "text": "Không mua pin độ,",
     "style": "Sub"
    },
    {
     "start": 53.51,
     "end": 55.33,
     "text": "không dùng bộ sạc không rõ thương hiệu,",
     "style": "Sub"
    },
    {
     "start": 55.35,
     "end": 56.16,
     "text": "không sạc qua đêm",
     "style": "Sub"
    },
    {
     "start": 56.18,
     "end": 57.48,
     "text": "khi không có người trông.",
     "style": "Sub"
    },
    {
     "start": 57.54,
     "end": 58.88,
     "text": "Hà Nội yêu cầu có khu sạc riêng,",
     "style": "Sub"
    },
    {
     "start": 58.9,
     "end": 60.57,
     "text": "không sạc qua đêm, có người giám sát.",
     "style": "Sub"
    },
    {
     "start": 60.63,
     "end": 62.34,
     "text": "Khu sạc tập trung thiếu giải pháp phòng",
     "style": "Sub"
    },
    {
     "start": 62.36,
     "end": 64.61,
     "text": "cháy bị phạt từ 40 đến 50 triệu đồng.",
     "style": "Sub"
    },
    {
     "start": 64.68,
     "end": 65.85,
     "text": "Bốn – Có sẵn bình chữa cháy,",
     "style": "Sub"
    },
    {
     "start": 65.87,
     "end": 66.54,
     "text": "chăn chữa cháy,",
     "style": "Sub"
    },
    {
     "start": 66.56,
     "end": 68.02,
     "text": "mặt nạ thoát hiểm và bộ sơ cứu.",
     "style": "Sub"
    },
    {
     "start": 68.09,
     "end": 69.68,
     "text": "Mua một lần, mỗi năm kiểm tra 10 phút.",
     "style": "Sub"
    },
    {
     "start": 69.75,
     "end": 72.79,
     "text": "Năm 2025, Việt Nam có 3.060 vụ cháy,",
     "style": "Sub"
    },
    {
     "start": 72.81,
     "end": 75.65,
     "text": "90 người mất mạng, 93 người bị thương,",
     "style": "Sub"
    },
    {
     "start": 75.67,
     "end": 79.15,
     "text": "thiệt hại khoảng 786,78 tỷ đồng.",
     "style": "Sub"
    },
    {
     "start": 79.21,
     "end": 80.69,
     "text": "Hãy hỏi cơ quan phòng cháy nơi bạn",
     "style": "Sub"
    },
    {
     "start": 80.71,
     "end": 81.63,
     "text": "ở cần trang bị gì.",
     "style": "Sub"
    },
    {
     "start": 81.69,
     "end": 83.02,
     "text": "Năm – Không tự xuống bể phốt,",
     "style": "Sub"
    },
    {
     "start": 83.04,
     "end": 83.89,
     "text": "hố ga, hầm kín.",
     "style": "Sub"
    },
    {
     "start": 83.95,
     "end": 85.34,
     "text": "Có người ngất cũng đừng xuống theo.",
     "style": "Sub"
    },
    {
     "start": 85.41,
     "end": 87.08,
     "text": "Người thứ hai xuống cứu người thứ nhất,",
     "style": "Sub"
    },
    {
     "start": 87.1,
     "end": 88.63,
     "text": "thường là người thứ hai cũng gục.",
     "style": "Sub"
    },
    {
     "start": 88.69,
     "end": 89.89,
     "text": "Những nơi này có thể thiếu oxy",
     "style": "Sub"
    },
    {
     "start": 89.91,
     "end": 90.75,
     "text": "hoặc tích khí độc.",
     "style": "Sub"
    },
    {
     "start": 90.82,
     "end": 92.03,
     "text": "Mở nắp chờ một lúc không đủ",
     "style": "Sub"
    },
    {
     "start": 92.05,
     "end": 92.9,
     "text": "để biết an toàn.",
     "style": "Sub"
    },
    {
     "start": 92.96,
     "end": 93.85,
     "text": "Cần thông gió, đo khí,",
     "style": "Sub"
    },
    {
     "start": 93.87,
     "end": 95.52,
     "text": "đồ bảo hộ và người giám sát bên ngoài.",
     "style": "Sub"
    },
    {
     "start": 95.58,
     "end": 97.52,
     "text": "Gọi số 114 và 115.",
     "style": "Sub"
    },
    {
     "start": 97.58,
     "end": 98.82,
     "text": "Năm việc, tốn rất ít tiền,",
     "style": "Sub"
    },
    {
     "start": 98.84,
     "end": 100.48,
     "text": "nhưng có thể giữ cả nhà an toàn.",
     "style": "Sub"
    },
    {
     "start": 100.55,
     "end": 101.42,
     "text": "Không cần làm hết.",
     "style": "Sub"
    },
    {
     "start": 101.49,
     "end": 102.21,
     "text": "Chọn một việc,",
     "style": "Sub"
    },
    {
     "start": 102.23,
     "end": 103.38,
     "text": "và làm ngay hôm nay.",
     "style": "Sub"
    }
   ]
  },
